@using NTPCMaterial.Models
@{
    ViewBag.Title = "Dashboard";
    ViewBag.Active = "Dashboard";

    int totalOrders = ViewBag.TotalOrders ?? 0;
    int totalQuantity = ViewBag.TotalQuantity ?? 0;
    int totalEmployees = ViewBag.TotalEmployees ?? 0;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int approvedCount = ViewBag.ApprovedCount ?? 0;
    int rejectedCount = ViewBag.RejectedCount ?? 0;

    var recentOrders = ViewBag.RecentOrders as List<MaterialPurchase> ?? new List<MaterialPurchase>();
    var pendingRequests = ViewBag.PendingRequests as List<MaterialRequest> ?? new List<MaterialRequest>();
}

@section Styles {
    <style>
        /* ── Topbar ── */
        .topbar {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 16px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topbar-left h1 {
            font-size: 18px;
            font-weight: 700;
            color: var(--ink);
        }

        .topbar-left p {
            font-size: 12px;
            color: var(--ink3);
            margin-top: 1px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            background: var(--blue-lt);
            color: var(--blue);
        }

        .btn-new {
            padding: 8px 16px;
            background: var(--blue);
            color: #fff;
            border: none;
            border-radius: 7px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-new:hover {
                background: #1e40af;
            }

        /* ── Content ── */
        .content {
            padding: 28px;
        }

        .toast {
            background: var(--green-lt);
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            padding: 12px 18px;
            color: var(--green);
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ── Stat cards ── */
        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 20px;
        }

        .stats-req {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .sc {
            background: var(--surface);
            border-radius: 10px;
            padding: 18px 20px;
            border: 1px solid var(--border);
        }

        .sc-label {
            font-size: 11px;
            font-weight: 700;
            color: var(--ink3);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }

        .sc-val {
            font-size: 28px;
            font-weight: 800;
            color: var(--ink);
            line-height: 1;
            margin-bottom: 2px;
        }

        .sc-sub {
            font-size: 11px;
            color: var(--ink3);
        }

        .sc-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 4px;
        }

        .dot-blue {
            background: var(--blue);
        }

        .dot-green {
            background: #22c55e;
        }

        .dot-slate {
            background: #64748b;
        }

        .dot-amber {
            background: #f59e0b;
        }

        .dot-emerald {
            background: #10b981;
        }

        .dot-red {
            background: #ef4444;
        }

        /* ── Section label ── */
        .section-label {
            font-size: 12px;
            font-weight: 700;
            color: var(--ink3);
            text-transform: uppercase;
            letter-spacing: 0.6px;
            margin-bottom: 10px;
        }

        /* ── Table card ── */
        .tcard {
            background: var(--surface);
            border-radius: 10px;
            border: 1px solid var(--border);
            overflow: hidden;
            margin-bottom: 28px;
        }

        .tcard-head {
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

            .tcard-head h2 {
                font-size: 14px;
                font-weight: 700;
            }

            .tcard-head a {
                font-size: 12px;
                color: var(--blue);
                text-decoration: none;
                font-weight: 600;
            }

        .tcard-head-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .pending-badge {
            background: #e0e7ff;
            color: #4338ca;
            font-size: 10px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 20px;
        }

        /* ── Tables ── */
        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            padding: 10px 14px;
            background: #f8fafc;
            font-size: 11px;
            font-weight: 700;
            color: var(--ink3);
            text-align: left;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--border);
        }

        tbody td {
            padding: 11px 14px;
            font-size: 13px;
            color: var(--ink2);
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover td {
            background: #f8fafc;
        }

        .amt {
            font-weight: 700;
            color: var(--ink);
            font-variant-numeric: tabular-nums;
        }

        /* ── Employee chip ── */
        .emp-chip {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .emp-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--blue);
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .emp-no {
            font-weight: 700;
            color: var(--ink);
            font-size: 13px;
        }

        /* ── Material name + code ── */
        .mat-name {
            font-weight: 600;
            color: var(--ink);
        }

        .mat-code {
            font-size: 11px;
            color: var(--ink3);
            margin-top: 1px;
        }

        /* ── Status badge ── */
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 700;
        }

        .badge-pending {
            background: #e0e7ff;
            color: #4338ca;
        }

        .badge-approved {
            background: var(--green-lt);
            color: var(--green);
        }

        .badge-rejected {
            background: var(--red-lt);
            color: var(--red);
        }

        /* ── Quick action buttons ── */
        .btn-approve, .btn-reject {
            padding: 4px 11px;
            border: none;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .btn-approve {
            background: var(--green-lt);
            color: var(--green);
        }

            .btn-approve:hover {
                background: #bbf7d0;
            }

        .btn-reject {
            background: var(--red-lt);
            color: var(--red);
        }

            .btn-reject:hover {
                background: #fecaca;
            }

        .action-cell {
            display: flex;
            gap: 5px;
        }

        /* ── Empty ── */
        .empty {
            padding: 40px;
            text-align: center;
            color: var(--ink3);
            font-size: 13px;
        }

            .empty span {
                font-size: 32px;
                display: block;
                margin-bottom: 10px;
            }

        /* ── Modal ── */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.35);
            z-index: 999;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.open {
                display: flex;
            }

        .modal {
            background: var(--surface);
            border-radius: 12px;
            width: 420px;
            padding: 28px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.18);
        }

            .modal h3 {
                font-size: 16px;
                font-weight: 700;
                margin-bottom: 6px;
            }

            .modal p {
                font-size: 13px;
                color: var(--ink2);
                margin-bottom: 18px;
            }

            .modal label {
                font-size: 12px;
                font-weight: 600;
                color: var(--ink2);
                display: block;
                margin-bottom: 5px;
            }

            .modal textarea {
                width: 100%;
                border: 1px solid var(--border);
                border-radius: 7px;
                padding: 9px 12px;
                font-size: 13px;
                resize: vertical;
                min-height: 80px;
                color: var(--ink);
                background: var(--bg);
                font-family: inherit;
            }

        .modal-actions {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            margin-top: 18px;
        }

        .btn-cancel {
            padding: 8px 18px;
            border: 1px solid var(--border);
            border-radius: 7px;
            background: var(--surface);
            font-size: 13px;
            cursor: pointer;
            font-weight: 600;
        }

        .btn-confirm-approve {
            padding: 8px 18px;
            border: none;
            border-radius: 7px;
            background: #16a34a;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-confirm-reject {
            padding: 8px 18px;
            border: none;
            border-radius: 7px;
            background: #b91c1c;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }
    </style>
}

<!-- Topbar -->
<div class="topbar">
    <div class="topbar-left">
        <h1>Dashboard</h1>
        <p>@DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <div class="topbar-right">
        <span class="pill">&#9679; Administrator</span>
        <a class="btn-new" href="@Url.Action("Add","MaterialPurchase")">+ Add Purchase Order</a>
    </div>
</div>

<div class="content">

    @if (TempData["Success"] != null)
    {
        <div class="toast">&#10003; @TempData["Success"]</div>
    }

    <!-- ── Row 1: Purchase stats ── -->
    <div class="section-label">Purchase Overview</div>
    <div class="stats">
        <div class="sc">
            <div class="sc-label"><span class="sc-dot dot-blue"></span>Total Records</div>
            <div class="sc-val">@totalOrders</div>
            <div class="sc-sub">All purchase records</div>
        </div>
        <div class="sc">
            <div class="sc-label"><span class="sc-dot dot-green"></span>Total Quantity</div>
            <div class="sc-val">@totalQuantity.ToString("N0")</div>
            <div class="sc-sub">Across all records</div>
        </div>
        <div class="sc">
            <div class="sc-label"><span class="sc-dot dot-slate"></span>Employees</div>
            <div class="sc-val">@totalEmployees</div>
            <div class="sc-sub">Registered users</div>
        </div>
    </div>

    <!-- ── Row 2: Request stats ── -->
    <div class="section-label">Material Requests</div>
    <div class="stats-req">
        <div class="sc">
            <div class="sc-label"><span class="sc-dot dot-amber"></span>Pending</div>
            <div class="sc-val" style="color:#b45309">@pendingCount</div>
            <div class="sc-sub">Awaiting review</div>
        </div>
        <div class="sc">
            <div class="sc-label"><span class="sc-dot dot-emerald"></span>Approved</div>
            <div class="sc-val" style="color:#15803d">@approvedCount</div>
            <div class="sc-sub">Approved so far</div>
        </div>
        <div class="sc">
            <div class="sc-label"><span class="sc-dot dot-red"></span>Rejected</div>
            <div class="sc-val" style="color:#b91c1c">@rejectedCount</div>
            <div class="sc-sub">Rejected so far</div>
        </div>
    </div>

    <!-- ── Pending Requests table ── -->
    <div class="tcard">
        <div class="tcard-head">
            <div class="tcard-head-left">
                <h2>&#9888; Pending Employee Requests</h2>
                @if (pendingCount > 0)
                {
                    <span class="pending-badge">@pendingCount pending</span>
                }
            </div>
            <a href="@Url.Action("AllRequests","MaterialRequest")">View all &rarr;</a>
        </div>

        @if (!pendingRequests.Any())
        {
            <div class="empty">
                <span>&#128203;</span>
                No pending requests right now.
            </div>
        }
        else
        {
            <table>
                <colgroup>
                    <col style="width:120px" />
                    <col style="width:140px" />
                    <col style="width:200px" />
                    <col style="width:55px" />
                    <col style="width:120px" />
                    <col style="width:100px" />
                    <col style="width:160px" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Request No.</th>
                        <th>Requested By</th>
                        <th>Material</th>
                        <th>Qty</th>
                        <th>Department</th>
                        <th>Required By</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in pendingRequests)
                    {
                        <tr>
                            <td><strong>@r.RequestNumber</strong></td>

                            
                            <td>
                                <div class="emp-chip">
                                    <div class="emp-avatar">
                                        @r.RequestedBy.Substring(0, Math.Min(2, r.RequestedBy.Length)).ToUpper()
                                    </div>
                                    <span class="emp-no">@r.RequestedBy</span>
                                </div>
                            </td>

                           
                            <td>
                                <div class="mat-name">@r.MaterialName</div>
                                <div class="mat-code">@r.MaterialCode</div>
                            </td>

                            <td><strong>@r.QuantityRequested</strong></td>
                            <td>@r.Department</td>
                            <td>@r.RequiredByDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="action-cell">
                                    <button class="btn-approve"
                                            onclick="openModal('approve', @r.Id, '@r.RequestNumber')">
                                        &#10003; Approve
                                    </button>
                                    <button class="btn-reject"
                                            onclick="openModal('reject', @r.Id, '@r.RequestNumber')">
                                        &#10005; Reject
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <!-- ── Recent Purchase Records table ── -->
    <div class="tcard">
        <div class="tcard-head">
            <h2>Recent Purchase Records</h2>
            <a href="@Url.Action("Records","MaterialPurchase")">View all &rarr;</a>
        </div>

        @if (!recentOrders.Any())
        {
            <div class="empty">
                <span>&#128203;</span>
                No purchase records yet. <a href="@Url.Action("Add","MaterialPurchase")">Add the first one.</a>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>PO Number</th>
                        <th>Material Code</th>
                        <th>Material Name</th>
                        <th>Quantity</th>
                        <th>Purchase Date</th>
                        <th>Added By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var po in recentOrders)
                    {
                        <tr>
                            <td><strong>@po.PONumber</strong></td>
                            <td>@po.MaterialCode</td>
                            <td>@po.MaterialName</td>
                            <td class="amt">@po.Quantity.ToString("N0")</td>
                            <td>@po.PurchaseDate.ToString("dd MMM yyyy")</td>
                            <td>@po.AddedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>

<!-- ── Approve Modal ── -->
<div class="modal-overlay" id="modal-approve">
    <div class="modal">
        <h3>&#10003; Approve Request</h3>
        <p id="approve-label">Add optional remarks before approving.</p>
        @using (Html.BeginForm("Approve", "MaterialRequest", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="approve-id" />
            <label>Remarks (optional)</label>
            <textarea name="reviewRemarks" placeholder="e.g. Approved for Q3 maintenance cycle…"></textarea>
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeModal('approve')">Cancel</button>
                <button type="submit" class="btn-confirm-approve">Confirm Approve</button>
            </div>
        }
    </div>
</div>

<!-- ── Reject Modal ── -->
<div class="modal-overlay" id="modal-reject">
    <div class="modal">
        <h3>&#10005; Reject Request</h3>
        <p id="reject-label">Provide a reason so the employee knows why.</p>
        @using (Html.BeginForm("Reject", "MaterialRequest", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="reject-id" />
            <label>Reason for rejection <span style="color:var(--red)">*</span></label>
            <textarea name="reviewRemarks" placeholder="e.g. Item already in stock…" required></textarea>
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeModal('reject')">Cancel</button>
                <button type="submit" class="btn-confirm-reject">Confirm Reject</button>
            </div>
        }
    </div>
</div>

<script>
    function openModal(type, id, reqNo) {
        document.getElementById(type + '-id').value = id;
        document.getElementById(type + '-label').textContent =
            type === 'approve'
                ? 'Approving request ' + reqNo + '. Add optional remarks.'
                : 'Rejecting request ' + reqNo + '. Please give a reason.';
        document.getElementById('modal-' + type).classList.add('open');
    }

    function closeModal(type) {
        document.getElementById('modal-' + type).classList.remove('open');
    }

    document.querySelectorAll('.modal-overlay').forEach(function (el) {
        el.addEventListener('click', function (e) {
            if (e.target === el) el.classList.remove('open');
        });
    });
</script>
