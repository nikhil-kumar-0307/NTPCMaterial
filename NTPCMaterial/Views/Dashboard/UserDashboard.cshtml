@{
    Layout = null;
    string empNo = Session["EmployeeNumber"]?.ToString() ?? "User";
}
@model NTPCMaterial.Models.UserDashboardViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Employee Dashboard — NTPC Material</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f0f4fa;
            color: #0a1628;
            display: flex;
            min-height: 100vh;
        }

        /* ── Sidebar ───────────────────────────────────── */
        .sidebar {
            width: 240px;
            min-height: 100vh;
            background: linear-gradient(180deg, #064e3b 0%, #065f46 100%);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
        }

        .sidebar-brand {
            padding: 28px 24px 24px;
            border-bottom: 1px solid rgba(255,255,255,.12);
        }

            .sidebar-brand .logo {
                width: 44px;
                height: 44px;
                background: #fff;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                font-weight: 800;
                color: #064e3b;
                margin-bottom: 12px;
            }

            .sidebar-brand h2 {
                color: #fff;
                font-size: 14px;
                font-weight: 700;
                line-height: 1.4;
            }

            .sidebar-brand p {
                color: rgba(255,255,255,.55);
                font-size: 11px;
                margin-top: 3px;
            }

        .nav-section {
            padding: 20px 0 8px;
        }

        .nav-label {
            padding: 0 20px 8px;
            font-size: 10px;
            font-weight: 700;
            color: rgba(255,255,255,.4);
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 20px;
            color: rgba(255,255,255,.75);
            font-size: 13.5px;
            cursor: pointer;
            transition: background .15s;
            text-decoration: none;
        }

            .nav-item:hover, .nav-item.active {
                background: rgba(255,255,255,.12);
                color: #fff;
            }

            .nav-item .icon {
                font-size: 17px;
                width: 22px;
                text-align: center;
            }

        .sidebar-footer {
            margin-top: auto;
            padding: 20px;
            border-top: 1px solid rgba(255,255,255,.12);
        }

            .sidebar-footer .emp-info {
                color: rgba(255,255,255,.7);
                font-size: 12px;
                margin-bottom: 12px;
            }

                .sidebar-footer .emp-info strong {
                    color: #fff;
                    display: block;
                    font-size: 13px;
                }

        .btn-logout {
            width: 100%;
            padding: 9px;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 7px;
            color: #fff;
            font-size: 13px;
            cursor: pointer;
        }

            .btn-logout:hover {
                background: rgba(255,255,255,.22);
            }

        /* ── Main ──────────────────────────────────────── */
        .main {
            margin-left: 240px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            background: #fff;
            padding: 18px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #e0e7f0;
        }

            .topbar h1 {
                font-size: 20px;
                font-weight: 700;
            }

        .badge-user {
            background: #dcfce7;
            color: #16a34a;
            border-radius: 20px;
            padding: 5px 14px;
            font-size: 12px;
            font-weight: 600;
        }

        .content {
            padding: 32px;
        }

        /* ── Alert ─────────────────────────────────────── */
        .alert-success {
            background: #dcfce7;
            color: #15803d;
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            padding: 12px 18px;
            margin-bottom: 24px;
            font-size: 13.5px;
        }

        /* ── Stats ─────────────────────────────────────── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 18px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px 22px;
            box-shadow: 0 2px 12px rgba(0,53,128,.07);
            border-left: 4px solid transparent;
        }

            .stat-card.teal {
                border-color: #0d9488;
            }

            .stat-card.blue {
                border-color: #0055b3;
            }

            .stat-card.green {
                border-color: #16a34a;
            }

            .stat-card.orange {
                border-color: #ea580c;
            }

        .stat-label {
            font-size: 11px;
            font-weight: 700;
            color: #6b7a99;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .stat-value {
            font-size: 30px;
            font-weight: 800;
            color: #0a1628;
            margin: 6px 0 4px;
        }

        .stat-sub {
            font-size: 12px;
            color: #9aa3bb;
        }

        /* ── Card box ───────────────────────────────────── */
        .card-box {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,53,128,.07);
            overflow: hidden;
            margin-bottom: 28px;
        }

        .card-box-header {
            padding: 18px 24px;
            border-bottom: 1px solid #e8ecf4;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .card-box-header h3 {
                font-size: 15px;
                font-weight: 700;
            }

            .card-box-header span {
                font-size: 12px;
                color: #6b7a99;
            }

        /* ── Table ─────────────────────────────────────── */
        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            padding: 12px 18px;
            background: #f8faff;
            font-size: 11.5px;
            font-weight: 700;
            color: #6b7a99;
            text-align: left;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        tbody td {
            padding: 13px 18px;
            font-size: 13.5px;
            color: #374060;
            border-top: 1px solid #f0f4fa;
        }

        tbody tr:hover {
            background: #f8faff;
        }

        /* ── Status badges ─────────────────────────────── */
        .status {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }

            .status.pending {
                background: #e0e7ff;
                color: #4338ca;
            }

            .status.approved {
                background: #dcfce7;
                color: #16a34a;
            }

            .status.rejected {
                background: #fee2e2;
                color: #dc2626;
            }

        /* ── "Request" button in catalogue table ─────── */
        .btn-request {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 14px;
            background: #064e3b;
            color: #fff;
            border: none;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: background .15s;
        }

            .btn-request:hover {
                background: #065f46;
            }

        /* ── Modal overlay ─────────────────────────────── */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(10,22,40,.45);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.open {
                display: flex;
            }

        .modal {
            background: #fff;
            border-radius: 14px;
            width: 520px;
            max-width: 95vw;
            box-shadow: 0 16px 48px rgba(0,0,0,.18);
            overflow: hidden;
        }

        .modal-header {
            padding: 20px 24px;
            background: #064e3b;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .modal-header h3 {
                font-size: 15px;
                font-weight: 700;
            }

        .modal-close {
            background: none;
            border: none;
            color: rgba(255,255,255,.8);
            font-size: 20px;
            cursor: pointer;
            line-height: 1;
        }

        .modal-body {
            padding: 24px;
        }

        .form-row {
            margin-bottom: 18px;
        }

            .form-row label {
                display: block;
                font-size: 12px;
                font-weight: 700;
                color: #374060;
                margin-bottom: 6px;
            }

            .form-row .field-info {
                background: #f0f4fa;
                border-radius: 7px;
                padding: 9px 12px;
                font-size: 13.5px;
                color: #0a1628;
            }

            .form-row input, .form-row select, .form-row textarea {
                width: 100%;
                padding: 9px 12px;
                border: 1.5px solid #dde3ee;
                border-radius: 7px;
                font-size: 13.5px;
                color: #0a1628;
                background: #fff;
                outline: none;
                transition: border-color .15s;
            }

                .form-row input:focus, .form-row select:focus, .form-row textarea:focus {
                    border-color: #0d9488;
                }

            .form-row textarea {
                resize: vertical;
                min-height: 72px;
            }

        .form-row-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .validation-msg {
            color: #dc2626;
            font-size: 11.5px;
            margin-top: 4px;
        }

        .modal-footer {
            padding: 16px 24px;
            border-top: 1px solid #e8ecf4;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-cancel {
            padding: 9px 20px;
            background: #f0f4fa;
            border: 1px solid #dde3ee;
            border-radius: 7px;
            font-size: 13px;
            color: #374060;
            cursor: pointer;
        }

        .btn-submit {
            padding: 9px 22px;
            background: #064e3b;
            border: none;
            border-radius: 7px;
            font-size: 13px;
            color: #fff;
            font-weight: 600;
            cursor: pointer;
        }

            .btn-submit:hover {
                background: #065f46;
            }
    </style>
</head>
<body>

    <!-- ═══════════════ SIDEBAR ═══════════════ -->
    <div class="sidebar">
        <div class="sidebar-brand">
            <div class="logo">NTPC</div>
            <h2>Material Management</h2>
            <p>Employee Portal</p>
        </div>
        <div class="nav-section">
            <div class="nav-label">Main</div>
            <a class="nav-item active" href="@Url.Action("UserDashboard","Dashboard")">
                <span class="icon">&#128202;</span> Dashboard
            </a>
            <a class="nav-item" href="@Url.Action("MyRequests","MaterialRequest")">
                <span class="icon">&#128203;</span> My Requests
            </a>
        </div>
        <div class="sidebar-footer">
            <div class="emp-info">
                <strong>@empNo</strong>Employee
            </div>
            <form action="@Url.Action("Logout","Account")" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">&#128274; Sign Out</button>
            </form>
        </div>
    </div>

    <!-- ═══════════════ MAIN ═══════════════ -->
    <div class="main">
        <div class="topbar">
            <h1>My Dashboard</h1>
            <span class="badge-user">&#9679; Employee — @empNo</span>
        </div>

        <div class="content">

            @if (TempData["Success"] != null)
            {
                <div class="alert-success">&#10003; @TempData["Success"]</div>
            }

            <!-- Stats -->
            <div class="stats-grid">
                <div class="stat-card teal">
                    <div class="stat-label">Total Requests</div>
                    <div class="stat-value">@Model.TotalRequests</div>
                    <div class="stat-sub">Lifetime submitted</div>
                </div>
                <div class="stat-card green">
                    <div class="stat-label">Approved</div>
                    <div class="stat-value">@Model.ApprovedRequests</div>
                    <div class="stat-sub">Fulfilled</div>
                </div>
                <div class="stat-card blue">
                    <div class="stat-label">Pending</div>
                    <div class="stat-value">@Model.PendingRequests</div>
                    <div class="stat-sub">Awaiting review</div>
                </div>
                <div class="stat-card orange">
                    <div class="stat-label">Rejected</div>
                    <div class="stat-value">@Model.RejectedRequests</div>
                    <div class="stat-sub">Not approved</div>
                </div>
            </div>

            <!-- ── Available Materials / Purchase Catalogue ── -->
            <div class="card-box">
                <div class="card-box-header">
                    <h3>&#128230; Available Materials</h3>
                    <span>Click "Request" to raise a material request</span>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Material Code</th>
                            <th>Material Name</th>
                            <th>PO Number</th>
                            <th>Purchase Date</th>
                            <th>Amount (₹)</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Purchases.Any())
                        {
                            foreach (var p in Model.Purchases)
                            {
                                <tr>
                                    <td><strong>@p.MaterialCode</strong></td>
                                    <td>@p.MaterialName</td>
                                    <td>@p.PONumber</td>
                                    <td>@p.PurchaseDate.ToString("dd MMM yyyy")</td>
                                    <td>@p.Amount.ToString("N2")</td>
                                    <td>
                                        <button class="btn-request"
                                                onclick="openModal(@p.Id, '@Html.Raw(p.MaterialCode)', '@Html.Raw(p.MaterialName)')">
                                            &#43; Request
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" style="text-align:center;padding:24px;color:#9aa3bb;">No materials available in the catalogue.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- ── My Recent Requests ── -->
            <div class="card-box">
                <div class="card-box-header">
                    <h3>&#128203; My Recent Requests</h3>
                    <a href="@Url.Action("MyRequests","MaterialRequest")" style="font-size:12px;color:#0055b3;text-decoration:none;">View all →</a>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Request No.</th>
                            <th>Material</th>
                            <th>Qty</th>
                            <th>Department</th>
                            <th>Required By</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentRequests.Any())
                        {
                            foreach (var r in Model.RecentRequests)
                            {
                                <tr>
                                    <td><strong>@r.RequestNumber</strong></td>
                                    <td>@r.MaterialName</td>
                                    <td>@r.QuantityRequested</td>
                                    <td>@r.Department</td>
                                    <td>@r.RequiredByDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="status @r.Status.ToLower()">@r.Status</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" style="text-align:center;padding:24px;color:#9aa3bb;">No requests yet. Use the catalogue above to raise your first request.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- ═══════════════ REQUEST MODAL ═══════════════ -->
    <div class="modal-overlay" id="requestModal">
        <div class="modal">
            <div class="modal-header">
                <h3>&#128203; Raise Material Request</h3>
                <button class="modal-close" onclick="closeModal()">&#10005;</button>
            </div>

            @using (Html.BeginForm("Create", "MaterialRequest", FormMethod.Post, new { id = "requestForm" }))
            {
                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <!-- Hidden: selected purchase -->
                    <input type="hidden" name="MaterialPurchaseId" id="hidPurchaseId" />

                    <div class="form-row">
                        <label>Selected Material</label>
                        <div class="field-info" id="lblMaterial">—</div>
                    </div>

                    <div class="form-row-2col">
                        <div class="form-row">
                            <label>Quantity Required <span style="color:#dc2626">*</span></label>
                            <input type="number" name="QuantityRequested" id="inpQty" min="1" placeholder="e.g. 10" required />
                        </div>
                        <div class="form-row">
                            <label>Required By Date <span style="color:#dc2626">*</span></label>
                            <input type="date" name="RequiredByDate" id="inpDate" required />
                        </div>
                    </div>

                    <div class="form-row">
                        <label>Department <span style="color:#dc2626">*</span></label>
                        <select name="Department" id="selDept" required>
                            <option value="">— Select Department —</option>
                            <option>Operations</option>
                            <option>Maintenance</option>
                            <option>Electrical</option>
                            <option>Civil</option>
                            <option>Instrumentation</option>
                            <option>Safety &amp; Environment</option>
                            <option>IT</option>
                            <option>Finance</option>
                            <option>HR</option>
                            <option>Stores</option>
                            <option>Projects</option>
                        </select>
                    </div>

                    <div class="form-row">
                        <label>Remarks (optional)</label>
                        <textarea name="Remarks" placeholder="Add any notes or justification…"></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
                    <button type="submit" class="btn-submit">&#128203; Submit Request</button>
                </div>
            }
        </div>
    </div>

    <script>
    // Set min date for required-by field to tomorrow
    (function () {
        var tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        document.getElementById('inpDate').min = tomorrow.toISOString().split('T')[0];
        document.getElementById('inpDate').value = new Date(Date.now() + 7 * 864e5).toISOString().split('T')[0];
    })();

    function openModal(purchaseId, code, name) {
        document.getElementById('hidPurchaseId').value = purchaseId;
        document.getElementById('lblMaterial').textContent = code + ' — ' + name;
        document.getElementById('inpQty').value = '';
        document.getElementById('selDept').value = '';
        document.getElementById('requestModal').classList.add('open');
    }

    function closeModal() {
        document.getElementById('requestModal').classList.remove('open');
    }

    // Close on backdrop click
    document.getElementById('requestModal').addEventListener('click', function (e) {
        if (e.target === this) closeModal();
    });

    // Basic client-side validation before submit
    document.getElementById('requestForm').addEventListener('submit', function (e) {
        var qty  = parseInt(document.getElementById('inpQty').value, 10);
        var dept = document.getElementById('selDept').value;
        var date = document.getElementById('inpDate').value;
        if (!qty || qty < 1 || !dept || !date) {
            e.preventDefault();
            alert('Please fill in all required fields.');
        }
    });
    </script>
</body>
</html>
