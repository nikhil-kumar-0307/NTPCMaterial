@{
    Layout = null;
    string empNo = Session["EmployeeNumber"]?.ToString() ?? "User";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Dashboard — NTPC Material</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f0f4fa;
            color: #0a1628;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 240px;
            min-height: 100vh;
            background: linear-gradient(180deg, #064e3b 0%, #065f46 100%);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
        }

        .sidebar-brand {
            padding: 28px 24px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.12);
        }

            .sidebar-brand .logo {
                width: 44px;
                height: 44px;
                background: #fff;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                font-weight: 800;
                color: #064e3b;
                margin-bottom: 12px;
            }

            .sidebar-brand h2 {
                color: #fff;
                font-size: 14px;
                font-weight: 700;
                line-height: 1.4;
            }

            .sidebar-brand p {
                color: rgba(255,255,255,0.55);
                font-size: 11px;
                margin-top: 3px;
            }

        .nav-section {
            padding: 20px 0 8px;
        }

        .nav-label {
            padding: 0 20px 8px;
            font-size: 10px;
            font-weight: 700;
            color: rgba(255,255,255,0.4);
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 20px;
            color: rgba(255,255,255,0.75);
            font-size: 13.5px;
            cursor: pointer;
            transition: background .15s;
            text-decoration: none;
        }

            .nav-item:hover, .nav-item.active {
                background: rgba(255,255,255,0.12);
                color: #fff;
            }

            .nav-item .icon {
                font-size: 17px;
                width: 22px;
                text-align: center;
            }

        .sidebar-footer {
            margin-top: auto;
            padding: 20px;
            border-top: 1px solid rgba(255,255,255,0.12);
        }

            .sidebar-footer .emp-info {
                color: rgba(255,255,255,0.7);
                font-size: 12px;
                margin-bottom: 12px;
            }

                .sidebar-footer .emp-info strong {
                    color: #fff;
                    display: block;
                    font-size: 13px;
                }

        .btn-logout {
            width: 100%;
            padding: 9px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 7px;
            color: #fff;
            font-size: 13px;
            cursor: pointer;
        }

            .btn-logout:hover {
                background: rgba(255,255,255,0.22);
            }

        .main {
            margin-left: 240px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            background: #fff;
            padding: 18px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #e0e7f0;
        }

            .topbar h1 {
                font-size: 20px;
                font-weight: 700;
            }

            .topbar .badge-user {
                background: #dcfce7;
                color: #16a34a;
                border-radius: 20px;
                padding: 5px 14px;
                font-size: 12px;
                font-weight: 600;
            }

        .content {
            padding: 32px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: #fff;
            border-radius: 12px;
            padding: 22px 24px;
            box-shadow: 0 2px 12px rgba(0,53,128,0.07);
            border-left: 4px solid transparent;
        }

            .stat-card.teal {
                border-color: #0d9488;
            }

            .stat-card.blue {
                border-color: #0055b3;
            }

            .stat-card.orange {
                border-color: #ea580c;
            }

        .stat-label {
            font-size: 12px;
            font-weight: 600;
            color: #6b7a99;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            font-size: 32px;
            font-weight: 800;
            color: #0a1628;
            margin: 6px 0 4px;
        }

        .stat-sub {
            font-size: 12px;
            color: #9aa3bb;
        }

        .card-box {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,53,128,0.07);
            overflow: hidden;
            margin-bottom: 28px;
        }

        .card-box-header {
            padding: 18px 24px;
            border-bottom: 1px solid #e8ecf4;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .card-box-header h3 {
                font-size: 15px;
                font-weight: 700;
            }

            .card-box-header span {
                font-size: 12px;
                color: #6b7a99;
            }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            padding: 12px 20px;
            background: #f8faff;
            font-size: 12px;
            font-weight: 700;
            color: #6b7a99;
            text-align: left;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        tbody td {
            padding: 13px 20px;
            font-size: 13.5px;
            color: #374060;
            border-top: 1px solid #f0f4fa;
        }

        tbody tr:hover {
            background: #f8faff;
        }

        .status {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }

            .status.pending {
                background: #e0e7ff;
                color: #4338ca;
            }

            .status.approved {
                background: #dcfce7;
                color: #16a34a;
            }

            .status.rejected {
                background: #fee2e2;
                color: #dc2626;
            }

            .status.in-stock {
                background: #dcfce7;
                color: #16a34a;
            }

            .status.low-stock {
                background: #fef3c7;
                color: #d97706;
            }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-brand">
            <div class="logo">NTPC</div>
            <h2>Material Management</h2>
            <p>User Portal</p>
        </div>
        <div class="nav-section">
            <div class="nav-label">Main</div>
            <a class="nav-item active" href="#"><span class="icon">&#128202;</span> Dashboard</a>
            <a class="nav-item" href="#"><span class="icon">&#128230;</span> View Inventory</a>
            <a class="nav-item" href="#"><span class="icon">&#128203;</span> My Requests</a>
            <a class="nav-item" href="#"><span class="icon">&#128196;</span> Reports</a>
        </div>
        <div class="sidebar-footer">
            <div class="emp-info">
                <strong>@empNo</strong>
                Employee
            </div>
            <form action="@Url.Action("Logout","Account")" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">&#128274; Sign Out</button>
            </form>
        </div>
    </div>

    <div class="main">
        <div class="topbar">
            <h1>My Dashboard</h1>
            <span class="badge-user">&#9679; Employee</span>
        </div>

        <div class="content">

            <div class="stats-grid">
                <div class="stat-card teal">
                    <div class="stat-label">My Requests</div>
                    <div class="stat-value">14</div>
                    <div class="stat-sub">Total submitted</div>
                </div>
                <div class="stat-card blue">
                    <div class="stat-label">Approved</div>
                    <div class="stat-value">9</div>
                    <div class="stat-sub">This month</div>
                </div>
                <div class="stat-card orange">
                    <div class="stat-label">Pending</div>
                    <div class="stat-value">3</div>
                    <div class="stat-sub">Awaiting approval</div>
                </div>
            </div>

            <!-- My Material Requests -->
            <div class="card-box">
                <div class="card-box-header">
                    <h3>&#128203; My Material Requests</h3>
                    <span>Recent activity</span>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Request ID</th>
                            <th>Material</th>
                            <th>Quantity</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>REQ-101</td><td>Safety Helmets</td><td>10</td><td>12 Jun 2024</td><td><span class="status approved">Approved</span></td></tr>
                        <tr><td>REQ-102</td><td>Insulation Cable</td><td>50m</td><td>11 Jun 2024</td><td><span class="status pending">Pending</span></td></tr>
                        <tr><td>REQ-103</td><td>Steel Bolts M20</td><td>200</td><td>10 Jun 2024</td><td><span class="status approved">Approved</span></td></tr>
                        <tr><td>REQ-104</td><td>Cooling Fans</td><td>4</td><td>09 Jun 2024</td><td><span class="status rejected">Rejected</span></td></tr>
                        <tr><td>REQ-105</td><td>Fire Extinguisher</td><td>2</td><td>08 Jun 2024</td><td><span class="status pending">Pending</span></td></tr>
                    </tbody>
                </table>
            </div>

            <!-- Available Inventory -->
            <div class="card-box">
                <div class="card-box-header">
                    <h3>&#128230; Available Inventory</h3>
                    <span>Current stock levels</span>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Category</th>
                            <th>Available Qty</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>Transformer Oil</td><td>Electrical</td><td>320</td><td><span class="status in-stock">In Stock</span></td></tr>
                        <tr><td>Safety Helmets</td><td>PPE</td><td>512</td><td><span class="status in-stock">In Stock</span></td></tr>
                        <tr><td>Insulation Cable</td><td>Wiring</td><td>85</td><td><span class="status low-stock">Low Stock</span></td></tr>
                        <tr><td>Steel Bolts M20</td><td>Hardware</td><td>1200</td><td><span class="status in-stock">In Stock</span></td></tr>
                        <tr><td>Fire Extinguisher</td><td>Safety</td><td>12</td><td><span class="status low-stock">Low Stock</span></td></tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</body>
</html>