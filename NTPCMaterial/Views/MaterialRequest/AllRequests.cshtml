@model IEnumerable<NTPCMaterial.Models.MaterialRequest>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Material Requests";
    ViewBag.Active = "AllRequests";
}

@section Styles {
    <style>
        .topbar {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 16px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topbar-left h1 {
            font-size: 18px;
            font-weight: 700;
            color: var(--ink);
        }

        .topbar-left p {
            font-size: 12px;
            color: var(--ink3);
            margin-top: 1px;
        }

        .content {
            padding: 28px;
        }

        .toast {
            background: var(--green-lt);
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            padding: 12px 18px;
            color: var(--green);
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ── Filter bar ── */
        .filter-bar {
            display: flex;
            gap: 8px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--ink2);
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

            .filter-btn.active, .filter-btn:hover {
                background: var(--blue);
                color: #fff;
                border-color: var(--blue);
            }

            .filter-btn.pending.active {
                background: #6366f1;
                border-color: #6366f1;
            }

            .filter-btn.approved.active {
                background: #16a34a;
                border-color: #16a34a;
            }

            .filter-btn.rejected.active {
                background: #b91c1c;
                border-color: #b91c1c;
            }

        /* ── Table card ── */
        .tcard {
            background: var(--surface);
            border-radius: 10px;
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .tcard-head {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .tcard-head h2 {
                font-size: 14px;
                font-weight: 700;
            }

        .count-pill {
            background: var(--blue-lt);
            color: var(--blue);
            font-size: 11px;
            font-weight: 700;
            padding: 2px 9px;
            border-radius: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            padding: 10px 14px;
            background: #f8fafc;
            font-size: 11px;
            font-weight: 700;
            color: var(--ink3);
            text-align: left;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--border);
        }

        tbody td {
            padding: 12px 14px;
            font-size: 13px;
            color: var(--ink2);
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover td {
            background: #f8fafc;
        }

        /* ── Employee chip ── */
        .emp-chip {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .emp-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--blue);
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .emp-no {
            font-weight: 700;
            color: var(--ink);
            font-size: 13px;
        }

        /* ── Material info ── */
        .mat-code {
            font-size: 11px;
            color: var(--ink3);
            margin-top: 1px;
        }

        .mat-name {
            font-weight: 600;
            color: var(--ink);
        }

        /* ── Status badges ── */
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 700;
        }

        .badge-pending {
            background: #e0e7ff;
            color: #4338ca;
        }

        .badge-approved {
            background: var(--green-lt);
            color: var(--green);
        }

        .badge-rejected {
            background: var(--red-lt);
            color: var(--red);
        }

        /* ── Action buttons ── */
        .btn-approve, .btn-reject {
            padding: 5px 12px;
            border: none;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .btn-approve {
            background: var(--green-lt);
            color: var(--green);
        }

            .btn-approve:hover {
                background: #bbf7d0;
            }

        .btn-reject {
            background: var(--red-lt);
            color: var(--red);
        }

            .btn-reject:hover {
                background: #fecaca;
            }

        .action-cell {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        /* ── Remarks input inline ── */
        .remarks-input {
            font-size: 12px;
            padding: 4px 8px;
            border: 1px solid var(--border);
            border-radius: 5px;
            width: 130px;
            color: var(--ink);
            background: var(--bg);
        }

        /* ── Empty state ── */
        .empty {
            padding: 48px;
            text-align: center;
            color: var(--ink3);
            font-size: 13px;
        }

            .empty span {
                font-size: 36px;
                display: block;
                margin-bottom: 10px;
            }

        /* ── Modal overlay for approve/reject ── */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.35);
            z-index: 999;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.open {
                display: flex;
            }

        .modal {
            background: var(--surface);
            border-radius: 12px;
            width: 420px;
            padding: 28px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.18);
        }

            .modal h3 {
                font-size: 16px;
                font-weight: 700;
                margin-bottom: 6px;
            }

            .modal p {
                font-size: 13px;
                color: var(--ink2);
                margin-bottom: 18px;
            }

            .modal label {
                font-size: 12px;
                font-weight: 600;
                color: var(--ink2);
                display: block;
                margin-bottom: 5px;
            }

            .modal textarea {
                width: 100%;
                border: 1px solid var(--border);
                border-radius: 7px;
                padding: 9px 12px;
                font-size: 13px;
                resize: vertical;
                min-height: 80px;
                color: var(--ink);
                background: var(--bg);
                font-family: inherit;
            }

        .modal-actions {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            margin-top: 18px;
        }

        .btn-cancel {
            padding: 8px 18px;
            border: 1px solid var(--border);
            border-radius: 7px;
            background: var(--surface);
            font-size: 13px;
            cursor: pointer;
            font-weight: 600;
        }

        .btn-confirm-approve {
            padding: 8px 18px;
            border: none;
            border-radius: 7px;
            background: #16a34a;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-confirm-reject {
            padding: 8px 18px;
            border: none;
            border-radius: 7px;
            background: #b91c1c;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }
    </style>
}

<div class="topbar">
    <div class="topbar-left">
        <h1>&#128228; Material Requests</h1>
        <p>Review and action employee material requests</p>
    </div>
</div>

<div class="content">

    @if (TempData["Success"] != null)
    {
        <div class="toast">&#10003; @TempData["Success"]</div>
    }

    @{
        string filter = Request.QueryString["status"] ?? "All";
        var allList = Model.ToList();
        var pendingCnt = allList.Count(r => r.Status == "Pending");
        var approvedCnt = allList.Count(r => r.Status == "Approved");
        var rejectedCnt = allList.Count(r => r.Status == "Rejected");

        var displayed = filter == "All"
            ? allList
            : allList.Where(r => r.Status == filter).ToList();
    }

    <!-- Filter tabs -->
    <div class="filter-bar">
        <a href="?status=All" class="filter-btn @(filter=="All"      ? "active" : "")">All <span>@allList.Count</span></a>
        <a href="?status=Pending" class="filter-btn pending  @(filter=="Pending"  ? "active pending"  : "")">&#9679; Pending @pendingCnt</a>
        <a href="?status=Approved" class="filter-btn approved @(filter=="Approved" ? "active approved" : "")">&#10003; Approved @approvedCnt</a>
        <a href="?status=Rejected" class="filter-btn rejected @(filter=="Rejected" ? "active rejected" : "")">&#10005; Rejected @rejectedCnt</a>
    </div>

    <div class="tcard">
        <div class="tcard-head">
            <h2>Request List</h2>
            <span class="count-pill">@displayed.Count records</span>
        </div>

        @if (!displayed.Any())
        {
            <div class="empty">
                <span>&#128203;</span>
                No @(filter == "All" ? "" : filter.ToLower()) requests found.
            </div>
        }
        else
        {
            <table>
                <colgroup>
                    <col style="width:110px" />  @* Request No *@
                    <col style="width:140px" />  @* Requested By *@
                    <col style="width:200px" />  @* Material *@
                    <col style="width:60px" />  @* Qty *@
                    <col style="width:120px" />  @* Department *@
                    <col style="width:100px" />  @* Req. By Date *@
                    <col style="width:100px" />  @* Submitted *@
                    <col style="width:90px" />  @* Status *@
                    <col style="width:200px" />  @* Actions / Remarks *@
                </colgroup>
                <thead>
                    <tr>
                        <th>Request No.</th>
                        <th>Requested By</th>
                        <th>Material</th>
                        <th>Qty</th>
                        <th>Department</th>
                        <th>Required By</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th>Action / Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in displayed)
                    {
                        <tr>
                            <td><strong>@r.RequestNumber</strong></td>

                            
                            <td>
                                <div class="emp-chip">
                                    <div class="emp-avatar">@r.RequestedBy.Substring(0, Math.Min(2, r.RequestedBy.Length)).ToUpper()</div>
                                    <span class="emp-no">@r.RequestedBy</span>
                                </div>
                            </td>

                            
                            <td>
                                <div class="mat-name">@r.MaterialName</div>
                                <div class="mat-code">@r.MaterialCode</div>
                            </td>

                            <td><strong>@r.QuantityRequested</strong></td>
                            <td>@r.Department</td>
                            <td>@r.RequiredByDate.ToString("dd MMM yyyy")</td>
                            <td>@r.CreatedAt.ToString("dd MMM yyyy")</td>

                            <td>
                                @{
                                    string badgeClass = r.Status == "Approved" ? "badge-approved"
                                                      : r.Status == "Rejected" ? "badge-rejected"
                                                      : "badge-pending";
                                }
                                <span class="badge @badgeClass">@r.Status</span>
                            </td>

                            <td>
                                @if (r.Status == "Pending")
                                {
                                    <div class="action-cell">
                                        <button class="btn-approve"
                                                onclick="openModal('approve', @r.Id, '@r.RequestNumber')">
                                            &#10003; Approve
                                        </button>
                                        <button class="btn-reject"
                                                onclick="openModal('reject', @r.Id, '@r.RequestNumber')">
                                            &#10005; Reject
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span style="font-size:12px;color:var(--ink3)">
                                        @(string.IsNullOrEmpty(r.ReviewRemarks) ? "—" : r.ReviewRemarks)
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- ── Approve Modal ── -->
<div class="modal-overlay" id="modal-approve">
    <div class="modal">
        <h3>&#10003; Approve Request</h3>
        <p id="approve-label">Add optional remarks before approving.</p>
        @using (Html.BeginForm("Approve", "MaterialRequest", FormMethod.Post, new { id = "form-approve" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="approve-id" />
            <label>Remarks (optional)</label>
            <textarea name="reviewRemarks" placeholder="e.g. Approved for Q3 maintenance cycle…"></textarea>
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeModal('approve')">Cancel</button>
                <button type="submit" class="btn-confirm-approve">Confirm Approve</button>
            </div>
        }
    </div>
</div>

<!-- ── Reject Modal ── -->
<div class="modal-overlay" id="modal-reject">
    <div class="modal">
        <h3>&#10005; Reject Request</h3>
        <p id="reject-label">Provide a reason so the employee knows why.</p>
        @using (Html.BeginForm("Reject", "MaterialRequest", FormMethod.Post, new { id = "form-reject" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="reject-id" />
            <label>Reason for rejection <span style="color:var(--red)">*</span></label>
            <textarea name="reviewRemarks" id="reject-remarks" placeholder="e.g. Item already in stock…" required></textarea>
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeModal('reject')">Cancel</button>
                <button type="submit" class="btn-confirm-reject">Confirm Reject</button>
            </div>
        }
    </div>
</div>

<script>
    function openModal(type, id, reqNo) {
        document.getElementById(type + '-id').value = id;
        document.getElementById(type + '-label').textContent =
            type === 'approve'
                ? 'Approving request ' + reqNo + '. Add optional remarks.'
                : 'Rejecting request ' + reqNo + '. Please give a reason.';
        document.getElementById('modal-' + type).classList.add('open');
    }

    function closeModal(type) {
        document.getElementById('modal-' + type).classList.remove('open');
    }

    // Close modal on backdrop click
    document.querySelectorAll('.modal-overlay').forEach(function(el) {
        el.addEventListener('click', function(e) {
            if (e.target === el) el.classList.remove('open');
        });
    });
</script>
