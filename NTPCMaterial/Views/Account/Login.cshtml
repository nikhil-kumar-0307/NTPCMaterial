@model NTPCMaterial.Models.DTOs.EmployeeDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NTPC Material — Login</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            display: flex;
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #0a1628;
        }

        /* ── Left panel ── */
        .panel-left {
            width: 45%;
            background: linear-gradient(160deg, #003580 0%, #0055b3 50%, #0072e5 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 60px 48px;
            position: relative;
            overflow: hidden;
        }

            .panel-left::before {
                content: '';
                position: absolute;
                width: 420px;
                height: 420px;
                border-radius: 50%;
                border: 60px solid rgba(255,255,255,0.06);
                top: -100px;
                left: -100px;
            }

            .panel-left::after {
                content: '';
                position: absolute;
                width: 300px;
                height: 300px;
                border-radius: 50%;
                border: 40px solid rgba(255,255,255,0.05);
                bottom: -60px;
                right: -60px;
            }

        .ntpc-logo {
            width: 90px;
            height: 90px;
            background: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 28px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.25);
            position: relative;
            z-index: 1;
        }

            .ntpc-logo span {
                font-size: 22px;
                font-weight: 800;
                color: #003580;
                letter-spacing: -1px;
            }

        .panel-left h1 {
            color: #fff;
            font-size: 28px;
            font-weight: 700;
            text-align: center;
            line-height: 1.3;
            position: relative;
            z-index: 1;
        }

        .panel-left p {
            color: rgba(255,255,255,0.72);
            font-size: 14px;
            margin-top: 12px;
            text-align: center;
            line-height: 1.6;
            position: relative;
            z-index: 1;
        }

        .badge-row {
            display: flex;
            gap: 12px;
            margin-top: 40px;
            position: relative;
            z-index: 1;
        }

        .badge {
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 20px;
            padding: 6px 16px;
            color: #fff;
            font-size: 12px;
            backdrop-filter: blur(4px);
        }

        /* ── Right panel ── */
        .panel-right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 32px;
            background: #f0f4fa;
        }

        .card {
            background: #fff;
            border-radius: 16px;
            padding: 48px 44px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 4px 40px rgba(0,53,128,0.10);
        }

        .card-header {
            margin-bottom: 32px;
        }

            .card-header h2 {
                font-size: 24px;
                font-weight: 700;
                color: #0a1628;
            }

            .card-header p {
                font-size: 14px;
                color: #6b7a99;
                margin-top: 6px;
            }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                font-size: 13px;
                font-weight: 600;
                color: #374060;
                margin-bottom: 7px;
                letter-spacing: 0.3px;
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap .icon {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #8a96b0;
                font-size: 16px;
                pointer-events: none;
            }

            .input-wrap input {
                width: 100%;
                padding: 11px 14px 11px 40px;
                border: 1.5px solid #d5dcea;
                border-radius: 8px;
                font-size: 14px;
                color: #0a1628;
                background: #f8faff;
                transition: border-color .2s, box-shadow .2s;
                outline: none;
            }

                .input-wrap input:focus {
                    border-color: #0055b3;
                    box-shadow: 0 0 0 3px rgba(0,85,179,0.12);
                    background: #fff;
                }

        .field-error {
            color: #d93025;
            font-size: 12px;
            margin-top: 5px;
        }

        .row-remember {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 28px;
        }

        .remember-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #6b7a99;
            cursor: pointer;
        }

            .remember-label input[type="checkbox"] {
                width: 15px;
                height: 15px;
                accent-color: #0055b3;
            }

        .btn-login {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #003580, #0055b3);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            letter-spacing: 0.3px;
            transition: opacity .2s, transform .1s;
        }

            .btn-login:hover {
                opacity: .92;
            }

            .btn-login:active {
                transform: scale(.98);
            }

        /* Validation summary */
        .alert-error {
            background: #fff0f0;
            border: 1px solid #f5c6c6;
            border-radius: 8px;
            padding: 12px 16px;
            color: #c0392b;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .divider {
            border: none;
            border-top: 1px solid #e8ecf4;
            margin: 28px 0 20px;
        }

        .footer-note {
            text-align: center;
            font-size: 12px;
            color: #9aa3bb;
        }

        @@media (max-width: 768px) {
            .panel-left {
                display: none;
            }

            body {
                background: #f0f4fa;
            }
        }
    </style>
</head>
<body>

    <!-- Left branding panel -->
    <div class="panel-left">
        <div class="ntpc-logo"><span>NTPC</span></div>
        <h1>Material Management<br>Portal</h1>
        <p>Secure access for authorised NTPC personnel only.<br>Use your employee credentials to sign in.</p>
        <div class="badge-row">
            <span class="badge">&#128274; Secure</span>
            <span class="badge">&#9989; Role-Based</span>
            <span class="badge">&#128202; Tracked</span>
        </div>
    </div>

    <!-- Right login form -->
    <div class="panel-right">
        <div class="card">
            <div class="card-header">
                <h2>Sign In</h2>
                <p>Enter your employee number and password.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-error">
                    @Html.ValidationSummary(true)
                </div>
            }

            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    @Html.LabelFor(m => m.EmployeeNumber, "Employee Number")
                    <div class="input-wrap">
                        <span class="icon">&#128100;</span>
                        @Html.TextBoxFor(m => m.EmployeeNumber, new
                        {
                            @class = "form-control",
                            placeholder = "e.g. EMP001",
                            autocomplete = "username"
                        })
                    </div>
                    <div class="field-error">
                        @Html.ValidationMessageFor(m => m.EmployeeNumber)
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Password, "Password")
                    <div class="input-wrap">
                        <span class="icon">&#128272;</span>
                        @Html.PasswordFor(m => m.Password, new
                        {
                            @class = "form-control",
                            placeholder = "Enter your password",
                            autocomplete = "current-password"
                        })
                    </div>
                    <div class="field-error">
                        @Html.ValidationMessageFor(m => m.Password)
                    </div>
                </div>

                <div class="row-remember">
                    <label class="remember-label">
                        @Html.CheckBoxFor(m => m.RememberMe)
                        Remember me
                    </label>
                </div>

                <button type="submit" class="btn-login">Sign In &rarr;</button>
            }

            <hr class="divider" />
            <p class="footer-note">
                &copy; @DateTime.Now.Year NTPC Limited &mdash; Authorised Use Only
            </p>
        </div>
    </div>

</body>
</html>