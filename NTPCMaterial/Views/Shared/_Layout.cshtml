@{
    string empNo = Session["EmployeeNumber"]?.ToString() ?? "Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - NTPC Material</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --ink: #0f172a;
            --ink2: #475569;
            --ink3: #94a3b8;
            --surface: #ffffff;
            --bg: #f1f5f9;
            --border: #e2e8f0;
            --blue: #1d4ed8;
            --blue-lt: #dbeafe;
            --green: #15803d;
            --green-lt: #dcfce7;
            --amber: #b45309;
            --amber-lt: #fef3c7;
            --red: #b91c1c;
            --red-lt: #fee2e2;
            --sidebar: #0f172a;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: var(--bg);
            color: var(--ink);
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 220px;
            background: var(--sidebar);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 100;
        }

        .sb-brand {
            padding: 24px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

            .sb-brand .mark {
                width: 36px;
                height: 36px;
                background: var(--blue);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-weight: 900;
                font-size: 12px;
                margin-bottom: 10px;
                letter-spacing: -0.5px;
            }

            .sb-brand .name {
                color: #fff;
                font-size: 13px;
                font-weight: 700;
            }

            .sb-brand .sub {
                color: rgba(255,255,255,0.4);
                font-size: 10px;
                margin-top: 2px;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

        .sb-nav {
            padding: 16px 0;
            flex: 1;
        }

        .sb-section {
            padding: 0 12px 4px;
            font-size: 9px;
            font-weight: 700;
            color: rgba(255,255,255,0.25);
            text-transform: uppercase;
            letter-spacing: 1.2px;
            margin-top: 16px;
        }

        .sb-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            margin: 1px 8px;
            border-radius: 7px;
            color: rgba(255,255,255,0.55);
            font-size: 13px;
            text-decoration: none;
            transition: background .15s, color .15s;
        }

            .sb-link:hover {
                background: rgba(255,255,255,0.07);
                color: rgba(255,255,255,0.9);
            }

            .sb-link.active {
                background: var(--blue);
                color: #fff;
            }

            .sb-link .ic {
                width: 18px;
                text-align: center;
                font-size: 15px;
            }

        .sb-foot {
            padding: 16px 12px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

        .sb-user {
            color: rgba(255,255,255,0.55);
            font-size: 11px;
            margin-bottom: 10px;
        }

            .sb-user strong {
                color: #fff;
                display: block;
                font-size: 12px;
                margin-bottom: 1px;
            }

        .btn-so {
            width: 100%;
            padding: 8px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 6px;
            color: rgba(255,255,255,0.7);
            font-size: 12px;
            cursor: pointer;
            transition: background .15s;
        }

            .btn-so:hover {
                background: rgba(255,255,255,0.14);
                color: #fff;
            }

        /* MAIN */
        .main {
            margin-left: 220px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>

    <div class="sidebar">
        <div class="sb-brand">
            <div class="mark">NT</div>
            <div class="name">NTPC Material</div>
            <div class="sub">Admin Portal</div>
        </div>
        <div class="sb-nav">
            <div class="sb-section">Main</div>
            <a class="sb-link @(ViewBag.Active == "Dashboard" ? "active" : "")" href="@Url.Action("AdminDashboard","Dashboard")">
                <span class="ic">&#9632;</span> Dashboard
            </a>
            <a class="sb-link @(ViewBag.Active == "AddPurchase" ? "active" : "")" href="@Url.Action("Add","MaterialPurchase")">
                <span class="ic">&#10133;</span> Add Purchase Order
            </a>
            <a class="sb-link @(ViewBag.Active == "PurchaseRecords" ? "active" : "")" href="@Url.Action("Records","MaterialPurchase")">
                <span class="ic">&#128203;</span> Purchase Records
            </a>
        </div>
        <div class="sb-foot">
            <div class="sb-user">
                <strong>@empNo</strong>
                Administrator
            </div>
            <form action="@Url.Action("Logout","Account")" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-so">Sign Out</button>
            </form>
        </div>
    </div>

    <div class="main">
        @RenderBody()
    </div>

</body>
</html>